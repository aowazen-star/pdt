export const actions = {
  default: async ({ request, locals }) => {
    const data = await request.formData();
    const sport = String(data.get('sport') ?? '');
    if (!SPORTS[sport]) return fail(400, { error: 'Pick a sport.' });

    const started_at = String(data.get('started_at') ?? '');
    if (!started_at) return fail(400, { error: 'Pick a date and time.' });

    const duration_minutes = data.get('duration_minutes');
    const perceived_effort = data.get('perceived_effort');
    const notes = data.get('notes');

    // Pull sport-specific metrics from the form by checking the sport's defined fields
    const metrics = {};
    for (const f of SPORTS[sport].fields) {
      const v = data.get(`metrics.${f.key}`);
      if (v !== null && v !== '') {
        metrics[f.key] = f.type === 'number' ? Number(v) : String(v);
      }
    }

    const { error } = await locals.supabase.from('workouts').insert({
      user_id: locals.user.id,
      sport,
      started_at: new Date(started_at).toISOString(),
      duration_minutes: duration_minutes ? Number(duration_minutes) : null,
      perceived_effort: perceived_effort ? Number(perceived_effort) : null,
      notes: notes ? String(notes) : null,
      metrics
    });
    if (error) return fail(400, { error: error.message });
    throw redirect(303, '/workouts');
  }
};


  let sport = $state('running');
